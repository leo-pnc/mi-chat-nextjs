NEXT_PUBLIC_SUPABASE_URL=https://tuproyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_anon_key_aca

# --- Notificaciones push (VAPID) ---
# Generalos una sola vez y no los cambies (o vas a tener que re-suscribir a todos).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=

# --- Service role key de Supabase (SECRETA) ---
# Project Settings → API → "service_role" key
SUPABASE_SERVICE_ROLE_KEY=

# --- Secreto compartido para el Database Webhook ---
SUPABASE_WEBHOOK_SECRET=

# --- Recordatorios diarios (Vercel Cron) ---
# Cualquier texto largo y secreto. Vercel lo manda solo al llamar /api/send-reminders
CRON_SECRET=
